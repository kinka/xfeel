# ============================================================
# xfeel 环境变量示例
# 复制为 .env 后按需修改；标 [必填] 的项在对应功能启用时必须设置。
# ============================================================

# ---------- LLM（对话/抽取主模型） ----------
# 本地 Ollama（默认）：
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:12b
# OpenAI-compatible 远程服务（备选）：
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=your_key_here
# LLM_PROTOCOL=chat            # chat（默认）| responses
# LLM_TIMEOUT_MS=30000

# 按角色分模型（可选，默认都用同一个）
# XFEEL_MODEL_EXTRACT=claude-sonnet-5
# XFEEL_MODEL_INTENT=claude-sonnet-5
# XFEEL_MODEL_REPLY=claude-sonnet-5
# XFEEL_REPLY_LLM_TIMEOUT_MS=20000

# ---------- Embedding（记忆召回向量，走 Ollama） ----------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# XFEEL_EMBEDDING_MODEL=qwen3-embedding:0.6b
# XFEEL_EMBEDDING_STARTUP_CHECK=1

# ---------- 数据与存储 ----------
# XFEEL_DB_PATH=./data/xfeel.db        # 主库（默认 data/xfeel.db）
# XFEEL_VEC_DB_PATH=./data/xfeel-vec.db
# XFEEL_MEDIA_DIR=./data/media         # 图片等媒体文件根目录
# XFEEL_BACKUP_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/xfeel-backup
# XFEEL_BACKUP_DISABLED=0

# ---------- API 服务 ----------
# PORT=8000
# TZ=Asia/Shanghai
# LOG_LEVEL=info

# ---------- 网页端与鉴权 ----------
# 部署域名 [必填：生产环境]，微信 OAuth 回跳和帮助文案都用它
# XFEEL_WEB_URL=https://your-domain.example
# JWT 签名密钥 [必填：生产/多实例]，不设则每次启动随机生成、重启后登录态失效
# XFEEL_JWT_SECRET=please_generate_a_long_random_string
# 管理接口令牌（dashboard/playground 管理操作）
# XFEEL_ADMIN_TOKEN=please_generate_a_long_random_string
# 本地调试可临时关闭鉴权（生产环境严禁开启）
# XFEEL_AUTH_DISABLED=0

# ---------- 微信公众号（可选通道） ----------
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_TOKEN=xfeel             # 服务器配置里的消息校验 Token
# WECHAT_ASYNC_ACK_REPLY=0

# ---------- 关怀/回声（可选微调） ----------
# XFEEL_ECHO_DAILY_CAP=1
# XFEEL_ECHO_MIN_AGE_DAYS=7
# XFEEL_ECHO_MIN_SIMILARITY=0.55
